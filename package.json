{
  "name": "@helloagent/sdk",
  "version": "0.1.0",
  "description": "HelloAgent SDK: talk to the relay from Node or the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "proto": "node node_modules/protobufjs-cli/bin/pbjs -t json-module -w es6 -o src/proto-bundle.js ../proto/helloagent/v1/protocol.proto && node scripts/patch-bundle.mjs",
    "build": "npm run proto && tsc",
    "echo": "tsx ../examples/ts_echo_agent.ts",
    "smoke": "tsx ../examples/ts_smoke.ts"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "protobufjs-cli": "^2.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
